# Sao chép file này thành .env.local (đã có trong .gitignore) rồi điền giá trị thật.
# Lấy tại: Supabase Dashboard → Project Settings → API.
# Anon/public key được THIẾT KẾ để lộ ra client (bảo vệ bằng Row Level Security, không phải
# giữ bí mật) nên an toàn khi dùng với tiền tố EXPO_PUBLIC_ (tự inline vào bundle app).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
